{
  "appearance": {
    "orientation": "horizontal",
    "font_size": 32,
    "theme": "system",
    "show_bopomofo": true,
    "zoom_level": 1,
    "geometry": "1391x1360+577+0",
    "input_display_mode": "smart_auto",
    "max_composition_chars": 30,
    "capsule_mode": "mini_capsule",
    "sidebar_width": 280
  },
  "keyboard": {
    "layout": "hsu",
    "space_behavior": "space_only",
    "capslock_switch": "chinese_english",
    "candidate_keys": "123456789",
    "backspace_mode": "component",
    "q_cycle_max": 3,
    "enable_mixed_english": false,
    "mixed_english_mode": "contextual_stream",
    "mixed_english_min_len": 4,
    "punctuation_commit_mode": "C",
    "enabled_keyboard_modes": [
      "hsu",
      "japanese"
    ]
  },
  "grammar": {
    "enable_all_eight_phases": true,
    "enable_de_vs_de_translingual": true,
    "enable_colloquial_biases": true,
    "enable_hot_reload": true
  },
  "ai_and_privacy": {
    "zero_pii_gateway": true,
    "ollama_model": "gemma4:12b",
    "enable_cloud_colab": true
  }
}